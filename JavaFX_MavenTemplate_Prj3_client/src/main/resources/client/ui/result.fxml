<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="client.ui.ResultController">

    <center>
        <VBox alignment="CENTER" spacing="16">
            <padding>
                <Insets top="40" bottom="40" left="40" right="40"/>
            </padding>

            <Label fx:id="resultLabel" text="You won!"/>

            <Label fx:id="winningsLabel" text="Winnings: 0"/>

            <Label fx:id="balanceLabelResult" text="Balance: $1000"/>

            <HBox alignment="CENTER" spacing="12">
                <Button fx:id="playAgainButton"
                        text="Play Again"
                        onAction="#handlePlayAgain"/>
                <Button fx:id="exitButton"
                        text="Exit"
                        onAction="#handleExit"/>
            </HBox>
        </VBox>
    </center>
</BorderPane>
